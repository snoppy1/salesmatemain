# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่คีย์จริง
# อย่า commit .env.local ขึ้น git
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx

# บัญชีผู้ดูแลระบบ (superadmin) — ดู/แก้ได้ทุกร้าน ที่ /admin
# ถ้าไม่ตั้ง 2 ตัวนี้ โซน /admin จะถูกปิดใช้งาน
PHUANG_ADMIN_USER=owner
PHUANG_ADMIN_PASS=ตั้งรหัสที่เดายากของคุณเอง

# Postgres (Neon) — connection string จาก Neon dashboard (ใช้ตัวที่มี -pooler)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Lazada Open Platform — ถ้าไม่ตั้ง 2 ตัวนี้ ระบบเชื่อมต่อจะทำงานโหมดทดลอง (mock)
# LAZADA_APP_KEY=
# LAZADA_APP_SECRET=
# LAZADA_CALLBACK_URL=https://your-app.vercel.app/api/connect/lazada/callback

# Shopee Open Platform — ถ้าไม่ตั้ง 2 ตัวนี้ ระบบเชื่อมต่อจะทำงานโหมดทดลอง (mock)
# SHOPEE_PARTNER_ID=
# SHOPEE_PARTNER_KEY=
# SHOPEE_CALLBACK_URL=https://your-app.vercel.app/api/connect/shopee/callback

# LINE Messaging API — ถ้าไม่ตั้ง 2 ตัวนี้ กล่องแชตจะทำงานโหมดจำลอง (ไม่ยิงเข้า LINE จริง)
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# (ทางเลือก) ระบุ username ของร้านที่จะรับข้อความ LINE — ถ้าไม่ตั้งใช้ร้านแรกในระบบ
# LINE_SHOP_USERNAME=
